{
  "name": "ai-social-deduction",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single-player social-deduction game with an AI cast",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client",
    "sim": "tsx src/sim/cli.ts",
    "llm:check": "tsx src/ai/llmCheck.ts",
    "ai": "tsx src/ai/cli.ts",
    "bakeoff": "tsx src/ai/bakeoff.ts",
    "ai:stats": "tsx src/ai/stats.ts",
    "build:client": "vite build",
    "server": "tsx src/server/main.ts",
    "play": "vite build && tsx src/server/main.ts",
    "dev:client": "vite"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "kokoro-js": "^1.2.1",
    "ws": "^8.23.0"
  }
}
